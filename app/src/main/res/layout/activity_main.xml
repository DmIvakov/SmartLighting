<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    android:background="#FAFAFA" >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Centrum sterowania światłem"
        android:textSize="24sp"
        android:background="#3F51B5"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:gravity="center"
        android:textStyle="bold"
        android:minHeight="48dp"
         />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="2"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp">

        <ImageView
            android:id="@+id/imgLivingRoom"
            android:layout_row="0"
            android:layout_column="0"
            android:src="@drawable/star_yellow"
            android:layout_margin="8dp"
            />
        <Button
            android:id="@+id/livingRoom"
            android:text="Salon: Żółty"
            android:layout_row="0"
            android:layout_column="1"
            android:textSize="17sp"
            android:layout_gravity="center_vertical"
            android:layout_margin="8dp"
            />

        <ImageView
            android:id="@+id/imgKitchen"
            android:layout_row="1"
            android:layout_column="0"
            android:src="@drawable/star_yellow"
            android:layout_margin="8dp"
            />
        <Button
            android:id="@+id/kitchen"
            android:text="Kuchnia: Żółty"
            android:layout_row="1"
            android:layout_column="1"
            android:textSize="17sp"
            android:layout_gravity="center_vertical"
            android:layout_margin="8dp"
            />

        <ImageView
            android:id="@+id/imgBedroom"
            android:layout_row="2"
            android:layout_column="0"
            android:src="@drawable/star_yellow"
            android:layout_margin="8dp"
            />
        <Button
            android:id="@+id/bedroom"
            android:text="Sypialnia: Żółty"
            android:layout_row="2"
            android:layout_column="1"
            android:textSize="17sp"
            android:layout_gravity="center_vertical"
            android:layout_margin="8dp"
            />
    </GridLayout>
        
    <RadioGroup
        android:id="@+id/rbtns"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        >

        <RadioButton
            android:id="@+id/day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tryb dzienny"
            android:textSize="17sp"
            />

        <RadioButton
            android:id="@+id/evening"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Tryb wieczorny"
            android:checked="true"
            android:textSize="17sp"
            />

        <RadioButton
            android:id="@+id/night"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Tryb nocny"
            android:textSize="17sp"
            />

    </RadioGroup>

    <Button
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ZAPISZ SCENĘ"
        android:backgroundTint="#3F51B5"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="15dp"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historia scen:"
        android:textStyle="bold"
        android:layout_marginLeft="5dp"
        />

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_height="250dp" />


</LinearLayout>